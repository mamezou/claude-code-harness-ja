#!/bin/bash
# コミット内容が、承認済みコミット対象一覧 (.claude/commit-plan.txt) と
# 完全一致する場合のみコミットを許可する。
# 「範囲語の拡大解釈で、対象一覧を示さずにコミットする」再発の機械的な防止。
#
# 有効化 (リポジトリごとに 1 回):
#   git config core.hooksPath .claude/git-hooks
#
# 運用:
#   1. Claude がコミット対象のファイル一覧をユーザーに提示する
#   2. ユーザーの承認後、Claude が同じ一覧を .claude/commit-plan.txt に書く
#      (1 行 1 パス、リポジトリルートからの相対パス。# 始まりと空行は無視)
#   3. git add でステージして commit する
#
# 特性:
#   - prepare-commit-msg は --no-verify でもスキップされない
#   - git は -a / pathspec 指定時に一時 index で hook を走らせるため、
#     ここでの diff --cached は「実際にコミットされる内容」を映す
#   - エイリアス・-C・cd・GIT_DIR 経由でも必ず通る (git 本体の hook のため)
#   - メッセージのみの amend も一覧一致が必要。例外運用はユーザー判断で
#     core.hooksPath を一時解除する
#   - Linux (GNU coreutils) 前提。改行・末尾空白を含むパスは扱わない

set -uo pipefail

fail() {
  printf '[commit-gate] %s\n' "$1" >&2
  exit 1
}

root=$(git rev-parse --show-toplevel 2>/dev/null) || fail "リポジトリルートを特定できません。"
plan="$root/.claude/commit-plan.txt"

if [[ ! -f "$plan" ]]; then
  fail "commit-plan.txt がありません。コミット対象の一覧をユーザーに提示して承認を得たあと、.claude/commit-plan.txt に書いてから commit してください。"
fi

now=$(date +%s)
mtime=$(stat -c %Y "$plan" 2>/dev/null) || fail "commit-plan.txt の更新時刻を取得できません。"
if (( now - mtime > 1800 )); then
  fail "commit-plan.txt が 30 分より古いため無効です。対象一覧を提示し直して承認を得てから、書き直してください。"
fi

planned=$(grep -vE '^[[:space:]]*(#|$)' "$plan" | sed 's/[[:space:]]*$//' | LC_ALL=C sort) || true
if [[ -z "$planned" ]]; then
  fail "commit-plan.txt に対象ファイルの行がありません。承認済みの一覧を書いてください。"
fi

staged=$(git -c core.quotepath=false diff --cached --name-only | LC_ALL=C sort) || fail "ステージ内容を取得できません。"

if [[ "$staged" != "$planned" ]]; then
  only_staged=$(comm -23 <(printf '%s\n' "$staged") <(printf '%s\n' "$planned") | sed 's/^/  + /')
  only_planned=$(comm -13 <(printf '%s\n' "$staged") <(printf '%s\n' "$planned") | sed 's/^/  - /')
  fail "コミット内容が承認済み一覧 (commit-plan.txt) と一致しません。
一覧にないコミット対象:
${only_staged:-  (なし)}
一覧にあるが対象外:
${only_planned:-  (なし)}
ステージを直すか、一覧をユーザーに提示し直して承認を得てください。"
fi

# コミット内容の機械検査 (シークレットの混入、外部送付物の内部表現)
# pre-commit ではなく本 hook から呼ぶ理由は pre-commit-checks.sh の冒頭に記載
checks="$root/.claude/git-hooks/pre-commit-checks.sh"
if [[ -x "$checks" ]]; then
  "$checks" || exit 1
fi

exit 0
